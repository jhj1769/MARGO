# Copy to `.env` and fill in. The MARGO LLM client reads these env vars
# directly (via python-dotenv if you load it).

# LLM backend selection: "openai" | "vllm" | "dummy"
MARGO_LLM_BACKEND=vllm

# OpenAI (only when MARGO_LLM_BACKEND=openai)
OPENAI_API_KEY=
MARGO_LLM_MODEL=gpt-4o-mini

# vLLM / local OpenAI-compatible server (only when MARGO_LLM_BACKEND=vllm)
MARGO_VLLM_BASE_URL=http://localhost:8000/v1
MARGO_VLLM_API_KEY=EMPTY
MARGO_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Trend Agent web search backend: "auto" | "tavily" | "serpapi" | "stub"
MARGO_TREND_BACKEND=auto
TAVILY_API_KEY=
SERPAPI_API_KEY=
